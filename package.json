{
  "name": "doughmination-music-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"bun run --filter @musicapp/server dev\" \"bun run --filter @musicapp/client dev\"",
    "build": "bun run --filter @musicapp/client build",
    "start": "bun run --filter @musicapp/server start",
    "migrate": "bun run --filter @musicapp/server migrate",
    "typecheck": "bun run --filter '*' typecheck",
    "desktop:dev": "bun run --filter @musicapp/desktop dev",
    "desktop:build": "bun run --filter @musicapp/desktop build"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.21.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "@types/bun": "^1.4.0"
  }
}
