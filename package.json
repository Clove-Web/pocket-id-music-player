{
  "name": "music-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"bun run --filter @musicapp/server dev\" \"bun run --filter @musicapp/web dev\"",
    "build": "bun run --filter @musicapp/web build",
    "start": "bun run --filter @musicapp/server start",
    "migrate": "bun run --filter @musicapp/server migrate",
    "typecheck": "bun run --filter '*' typecheck",
    "desktop:dev": "cd apps/desktop/src-tauri && cargo tauri dev",
    "desktop:build": "cd apps/desktop/src-tauri && cargo tauri build"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.14"
  }
}
