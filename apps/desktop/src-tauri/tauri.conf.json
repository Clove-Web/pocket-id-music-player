{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doughmination Music",
  "version": "1.0.0",
  "identifier": "uk.doughmination.music.desktop",
  "build": {
    "frontendDist": "https://doughmination.me",
    "devUrl": "https://doughmination.me",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Doughmination Music",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["doughmination"],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": ["doughmination"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [
        "discord_social_sdk/lib/release/libdiscord_partner_sdk.dylib",
        "discord_social_sdk/lib/release/libdiscord_krisp.dylib"
      ]
    }
  }
}
