{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music",
  "version": "0.1.0",
  "identifier": "uk.doughmination.music.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "https://doughmination.me",
    "beforeDevCommand": "",
    "beforeBuildCommand": "bun run --filter @musicapp/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Music",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
