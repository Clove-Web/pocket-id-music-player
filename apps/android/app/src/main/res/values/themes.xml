<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Parented on AppCompat so we don't need the full Material Components
         dependency; the UI is a WebView, so the theme only controls the window
         chrome. Black background avoids a white flash before the page paints. -->
    <style name="Theme.DoughminationMusic" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
</resources>
