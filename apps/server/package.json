{
  "name": "@musicapp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "start": "NODE_ENV=production bun run src/server.ts",
    "migrate": "bun run src/db/migrate.ts",
    "backfill:opus": "bun run src/db/backfill-opus.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@musicapp/shared": "workspace:*",
    "hono": "^4.13.3",
    "ioredis": "^5.11.1",
    "jose": "^6.2.9",
    "music-metadata": "^11.15.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
